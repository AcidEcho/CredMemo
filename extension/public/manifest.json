{
  "manifest_version": 3,
  "name": "CredMemo",
  "version": "2.6.0",
  "description": "本地加密保存账号、密码和 2FA，支持动态验证码、网站填充与加密备份。",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "activeTab", "scripting", "clipboardWrite", "alarms"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CredMemo",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+C" }, "description": "打开 CredMemo" }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'none'; frame-src 'none'"
  }
}
